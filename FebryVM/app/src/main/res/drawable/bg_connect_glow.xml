<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/brand_glow" />
        </shape>
    </item>
    <!-- Inner ring -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#1AFFFFFF"
                android:endColor="@color/surface_elevated" />
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_cyan" />
        </shape>
    </item>
</layer-list>
