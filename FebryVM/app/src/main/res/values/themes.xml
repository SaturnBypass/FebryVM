<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Common base theme: dark premium palette -->
    <style name="AppThemeBase" parent="Theme.Material3.DayNight">
        <item name="android:fontFamily">@font/inter_font</item>
        <item name="fontFamily">@font/inter_font</item>

        <!-- Primary: neon cyan -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <!-- Secondary: violet accent -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <!-- Tertiary: mint -->
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>

        <!-- Error -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>

        <!-- Surface tonal layers -->
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorSurfaceContainerLowest">#070A14</item>
        <item name="colorSurfaceContainerLow">#0F1422</item>
        <item name="colorSurfaceContainer">#131829</item>
        <item name="colorSurfaceContainerHigh">#1A1F2E</item>
        <item name="colorSurfaceContainerHighest">#222840</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <!-- Other -->
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/md_theme_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Shape -->
        <item name="shapeAppearanceCornerSmall">@style/Shape.Febry.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Febry.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Febry.Large</item>
    </style>

    <style name="Shape.Febry.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="Shape.Febry.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape.Febry.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Day/Night theme -->
    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <!-- Theme without ActionBar -->
    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeDayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppThemeDayNight.NoActionBar.Translucent">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="BrandedSwitch" parent="AppThemeDayNight">
        <item name="colorPrimary">@color/brand_cyan</item>
    </style>

    <!-- Theme variants by accent color (preserved for settings option) -->
    <style name="AppTheme.Orange" parent="AppThemeDayNight.NoActionBar">
        <item name="colorPrimary">#FF8A3D</item>
        <item name="colorSecondary">#FFB57A</item>
    </style>

    <style name="AppTheme.Blue" parent="AppThemeDayNight.NoActionBar">
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorSecondary">#7C5CFF</item>
    </style>

    <style name="AppTheme.Green" parent="AppThemeDayNight.NoActionBar">
        <item name="colorPrimary">#3DDC97</item>
        <item name="colorSecondary">#A5F2CB</item>
    </style>

    <style name="AppTheme.Purple" parent="AppThemeDayNight.NoActionBar">
        <item name="colorPrimary">#B5A6FF</item>
        <item name="colorSecondary">#7C5CFF</item>
    </style>

    <style name="AppTheme.Red" parent="AppThemeDayNight.NoActionBar">
        <item name="colorPrimary">#FF5C7A</item>
        <item name="colorSecondary">#FFB4AB</item>
    </style>

</resources>
